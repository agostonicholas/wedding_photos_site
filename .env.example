# Copy to .env and adjust locally. Shell environment variables take precedence.
HOST=127.0.0.1
PORT=4000
# Portable default: ./server/uploads. Existing photos on this machine:
# PHOTO_STORAGE_ROOT=/home/nick/Pictures/Wedding_Photos
# Leave empty for wedding guests to open the link directly.
# Optional temporary protection: set a code (at least 12 characters in production).
ACCESS_CODE=
# Separate owner credential: generate with npm run admin:code; guests never need it.
# ADMIN_CODE_HASH is generated automatically in your ignored .env.
# NODE_ENV=production
# TRUST_PROXY=loopback
# GitHub Pages frontend. Use the origin only, with no repository path.
# CORS_ORIGINS=https://agostonicholas.github.io
# SESSION_SECRET=<at least 32 random characters; otherwise persisted in storage>
# HOST=0.0.0.0 enables access from other devices on your home network.
# MAX_FILES=5
# MAX_TOTAL_BYTES=104857600
# MAX_STORAGE_BYTES=53687091200
# UPLOAD_RATE_LIMIT=300
# LOGIN_RATE_LIMIT=20
# LEGACY_STORAGE_ROOTS=/path/to/old/storage,/another/storage
